#include <iostream>
using namespace std;

class Account {
public:
    const long accNo;
    long transactionID;
    string type;
    double balance;

    Account(long a, double b) : accNo(a) {
        balance = b;
        transactionID = 0;
    }

    long depositAmount(const long to, const long from, const double amount) {
        balance += amount;
        transactionID++;
        type = "credit";
        return transactionID;
    }

    long creditAmount(const long to, const long from, const double amount) {
        balance -= amount;
        transactionID++;
        type = "debit";
        return transactionID;
    }

    void displayDetails() const {
        cout << accNo << " " << balance << " " << type << endl;
    }
};

int main() {
    Account a1(101, 1000);

    a1.depositAmount(101, 102, 500);
    a1.creditAmount(101, 102, 200);

    a1.displayDetails();
}
