#include <iostream>
using namespace std;

class Book {
public:
    string title, author;
    int ISBN;

    Book() {}

    Book(string title, string author, int ISBN) {
        this->title = title;
        this->author = author;
        this->ISBN = ISBN;
    }

    Book(const Book &b) {
        this->title = b.title;
        this->author = b.author;
        this->ISBN = b.ISBN;
    }
};

class Library {
public:
    Book books[5] = {
        Book("A","X",1),
        Book("B","Y",2),
        Book("C","Z",3)
    };

    int count = 3;

    bool removeBooks(int ISBN) {
        for (int i = 0; i < count; i++) {
            if (books[i].ISBN == ISBN) {
                for (int j = i; j < count - 1; j++)
                    books[j] = books[j + 1];
                count--;
                return true;
            }
        }
        return false;
    }

    void displayDetails() {
        for (int i = 0; i < count; i++)
            cout << books[i].title << " "
                 << books[i].author << " "
                 << books[i].ISBN << endl;
    }
};

int main() {
    Library l;
    l.displayDetails();
}
