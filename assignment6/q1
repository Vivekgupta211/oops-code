#include <iostream>
using namespace std;

class Book {
public:
    string title, author;
    int ISBN;
};

class Library {
public:
    Book books[10];
    int count = 0;

    bool addNewBook(string &title, string &author, int &ISBN) {
        if (count >= 10) return false;

        books[count].title = title;
        books[count].author = author;
        books[count].ISBN = ISBN;
        count++;
        return true;
    }

    bool removeBooks(int &ISBN) {
        for (int i = 0; i < count; i++) {
            if (books[i].ISBN == ISBN) {
                for (int j = i; j < count - 1; j++) {
                    books[j] = books[j + 1];
                }
                count--;
                return true;
            }
        }
        return false;
    }

    void displayDetails() {
        for (int i = 0; i < count; i++) {
            cout << books[i].title << " "
                 << books[i].author << " "
                 << books[i].ISBN << endl;
        }
    }
};

int main() {
    Library lib;

    string t = "Book1", a = "Author1"; int id = 101;
    lib.addNewBook(t, a, id);

    t = "Book2"; a = "Author2"; id = 102;
    lib.addNewBook(t, a, id);

    lib.displayDetails();

    lib.removeBooks(id);

    cout << "\nAfter deletion:\n";
    lib.displayDetails();
}
