#include <iostream>
using namespace std;

class B;

class A {
private:
    int x;
public:
    void set(int a) { x = a; }
    friend void swap(A &, B &);
    void show() { cout << x << endl; }
};

class B {
private:
    int y;
public:
    void set(int b) { y = b; }
    friend void swap(A &, B &);
    void show() { cout << y << endl; }
};

void swap(A &a, B &b) {
    int temp = a.x;
    a.x = b.y;
    b.y = temp;
}

int main() {
    A a; B b;
    a.set(5);
    b.set(10);

    swap(a, b);

    a.show();
    b.show();

    return 0;
}
