#include <iostream>
#include <fstream>
using namespace std;

int countAlpha() {
    ifstream fin("NOTES.TXT");
    char ch;
    int count = 0;

    while (fin.get(ch)) {
        if (isalpha(ch))
            count++;
    }

    fin.close();
    return count;
}

int main() {
    cout << "Total alphabets = " << countAlpha();
    return 0;
}
