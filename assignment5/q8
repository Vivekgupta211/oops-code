#include <iostream>
using namespace std;

class LibraryUser {
public:
    string name;
};

class Student : public LibraryUser {
public:
    int grade;
};

class Teacher : public LibraryUser {
public:
    string dept;
};

int main() {
    Student s;
    Teacher t;

    s.name = "Aman"; s.grade = 10;
    t.name = "Sir"; t.dept = "Math";

    cout << s.name << " " << s.grade << endl;
    cout << t.name << " " << t.dept;
}
