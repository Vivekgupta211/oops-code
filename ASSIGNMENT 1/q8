#include <iostream>
using namespace std;

int main() {
    int days;

    cin >> days;

    if (days <= 5)
        cout << "Fine = " << days * 0.5;

    else if (days <= 10)
        cout << "Fine = " << days * 1;

    else if (days <= 30)
        cout << "Fine = " << days * 5;

    else
        cout << "Membership Cancelled";

    return 0;
}
