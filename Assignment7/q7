#include <iostream>
using namespace std;

class Matrix {
public:
    int a[2][2];

    void input() {
        for(int i=0;i<2;i++)
            for(int j=0;j<2;j++)
                cin >> a[i][j];
    }

    friend Matrix operator*(Matrix m1, Matrix m2) {
        Matrix m;
        for(int i=0;i<2;i++) {
            for(int j=0;j<2;j++) {
                m.a[i][j]=0;
                for(int k=0;k<2;k++)
                    m.a[i][j]+=m1.a[i][k]*m2.a[k][j];
            }
        }
        return m;
    }

    void display() {
        for(int i=0;i<2;i++) {
            for(int j=0;j<2;j++)
                cout << a[i][j] << " ";
            cout << endl;
        }
    }
};
