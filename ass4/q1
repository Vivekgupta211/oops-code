#include <iostream>
using namespace std;

class Rectangle {
    int length, breadth;

public:
    // No parameter constructor
    Rectangle() {
        length = 0;
        breadth = 0;
    }

    // Two parameter constructor
    Rectangle(int l, int b) {
        length = l;
        breadth = b;
    }

    // One parameter constructor
    Rectangle(int x) {
        length = x;
        breadth = x;
    }

    int area() {
        return length * breadth;
    }
};

int main() {
    Rectangle r1;        // no parameter
    Rectangle r2(5);     // one parameter
    Rectangle r3(4, 6);  // two parameter

    cout << "Area1: " << r1.area() << endl;
    cout << "Area2: " << r2.area() << endl;
    cout << "Area3: " << r3.area() << endl;

    return 0;
}
