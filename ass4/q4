#include <iostream>
using namespace std;

// Class for object examples
class Test {
public:
    void show() {
        cout << "Hello\n";
    }
};

int main() {

    // (a) Integer variable
    int *p = new int;
    *p = 10;
    cout << "Integer value: " << *p << endl;
    delete p;

    // (b) Float variable
    float *f = new float;
    *f = 5.5;
    cout << "Float value: " << *f << endl;
    delete f;

    // (c) Integer array
    int *arr1 = new int[3];

    for (int i = 0; i < 3; i++) {
        arr1[i] = i + 1;
    }

    cout << "Integer array: ";
    for (int i = 0; i < 3; i++) {
        cout << arr1[i] << " ";
    }
    cout << endl;

    delete[] arr1;

    // (d) Float array
    float *arr2 = new float[3];

    for (int i = 0; i < 3; i++) {
        arr2[i] = i + 1.5;
    }

    cout << "Float array: ";
    for (int i = 0; i < 3; i++) {
        cout << arr2[i] << " ";
    }
    cout << endl;

    delete[] arr2;

    // (e) Class object
    Test *t1 = new Test;
    cout << "Class object: ";
    t1->show();
    delete t1;

    // (f) Array of objects
    Test *t2 = new Test[3];

    cout << "Array of objects:\n";
    for (int i = 0; i < 3; i++) {
        t2[i].show();
    }

    delete[] t2;

    return 0;
}
